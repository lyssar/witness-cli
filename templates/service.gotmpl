{{- define "service" }}
[Unit]
Description=Skuld CLI {{ .Observer.Metadata.Name }} service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

User={{ .Observer.Metadata.User }}
Group={{ .Observer.Metadata.User }}

WorkingDirectory=/home/{{ .Observer.Metadata.User }}

ExecStart=/usr/local/bin/skuld-cli reconcile {{ .ObserverConfigPath }}
{{- end }}
