{{- define "observer" }}
apiVersion: skuld/v1alpha1
kind: Observer
metadata:
  name: {{ .Spec.Project }}
spec:
  project: {{ .Spec.Project }}
  source:
    repoURL: {{ .Spec.Source.RepoURL }}
    targetRevision: {{ if .Spec.Source.TargetRevision }}{{ .Spec.Source.TargetRevision }}{{ else }}HEAD{{ end }}
  {{- if .Secrets }}
  secrets:
  {{- range $k, $v := .Secrets }}
    {{ $k }}: {{ encryptSecret $v $.AgeKeyFile }}
  {{- end }}
  {{- end }}
{{- end }}
