{{- define "application" -}}
apiVersion: witness.dev/v1alpha1
kind: Application
metadata:
  name: {{ .Metadata.Name }}
{{- if .Metadata.Description }}
  description: {{ .Metadata.Description }}
{{- end }}
{{- if .Metadata.Labels }}
  labels:
{{- range $key, $value := .Metadata.Labels }}
    {{ $key }}: {{ $value }}
{{- end }}
{{- end }}
{{- if .Metadata.Annotations }}
  annotations:
{{- range $key, $value := .Metadata.Annotations }}
    {{ $key }}: {{ $value }}
{{- end }}
{{- end }}
spec:
  provisioner: {{ .Spec.Provisioner }}
  composeFiles:
{{- range .Spec.ComposeFiles }}
    - {{ . }}
{{- end }}
{{- if .Spec.VolumeClaims }}
  volumeClaims:
{{- range .Spec.VolumeClaims }}
    - dir: {{ .Dir }}
      uid: {{ .UID }}
      gid: {{ .GID }}
{{- end }}
{{- end }}
{{- if .Spec.Secrets }}
  secrets:
{{- range .Spec.Secrets }}
    - source: {{ .Source }}
      target: {{ .Target }}
      decryptor: {{ .Decryptor }}
{{- end }}
{{- end }}
{{- if .Spec.RegistryCredentials }}
  registryCredentials:
    registry: {{ .Spec.RegistryCredentials.Registry }}
    username: {{ .Spec.RegistryCredentials.Username }}
    password: {{ .Spec.RegistryCredentials.Password }}
{{- end }}
{{- end -}}
